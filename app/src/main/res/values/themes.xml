<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the phone's dark/light setting: Light here, Dark in values-night. -->
    <style name="Theme.MemoCtrl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ctrl_accent_text</item>
    </style>
</resources>
